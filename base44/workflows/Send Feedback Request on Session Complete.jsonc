{
  "name": "Send Feedback Request on Session Complete",
  "description": "Automatically sends feedback request email when a session is marked as completed",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Session"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_feedback_request_on_session_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendFeedbackRequest",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendFeedbackRequest"
  }
}