{
  "name": "Task Assignee Notification",
  "description": "Sends email notification to task assignee when status changes or blocking task is completed",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) or (.trigger.changed_fields | index(\"blocking_task_ids\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "task_assignee_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTaskAssignee",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyTaskAssignee"
  }
}