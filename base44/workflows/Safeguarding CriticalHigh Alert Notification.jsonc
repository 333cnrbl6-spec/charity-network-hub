{
  "name": "Safeguarding Critical/High Alert Notification",
  "description": "Automatically send instant email alerts to the Safeguarding Lead when incidents are created or marked as critical or high risk.",
  "trigger": {
    "condition": "${ (.trigger.data.ai_severity_classification == \"critical\" or .trigger.data.ai_severity_classification == \"high\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SafeguardingIncident"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "safeguarding_critical_high_alert_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySafeguardingLead",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifySafeguardingLead"
  }
}