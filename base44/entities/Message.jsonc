{
  "name": "Message",
  "type": "object",
  "properties": {
    "channel_name": {
      "type": "string",
      "description": "Channel this message belongs to"
    },
    "author": {
      "type": "string",
      "description": "Author name or 'AI' for AI-generated messages"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "thread_id": {
      "type": "string",
      "description": "Parent message ID if this is a reply (for threading)"
    },
    "thread_depth": {
      "type": "number",
      "default": 0,
      "description": "Depth in thread (0 for root messages)"
    },
    "reply_count": {
      "type": "number",
      "default": 0,
      "description": "Number of direct replies"
    },
    "reactions": {
      "type": "object",
      "description": "Reaction counts (emoji: count)",
      "additionalProperties": {
        "type": "number"
      }
    },
    "is_ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this message was generated by AI"
    },
    "ai_member_name": {
      "type": "string",
      "description": "Name of AI member if applicable"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "channel_name",
    "author",
    "content"
  ]
}