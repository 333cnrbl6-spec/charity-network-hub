{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "charity_id": {
      "type": "string",
      "description": "Reference to Charity"
    },
    "name": {
      "type": "string",
      "description": "Volunteer name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "role": {
      "type": "string",
      "description": "Role/position"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "limited",
        "unavailable"
      ],
      "default": "available",
      "description": "Availability status"
    },
    "hours_contributed": {
      "type": "number",
      "default": 0,
      "description": "Total volunteer hours"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When volunteer started"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills/expertise"
    }
  },
  "required": [
    "charity_id",
    "name",
    "email",
    "role"
  ]
}