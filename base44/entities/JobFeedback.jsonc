{
  "name": "JobFeedback",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Reference to completed Job"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client"
    },
    "client_name": {
      "type": "string",
      "description": "Client name for reference"
    },
    "volunteer_id": {
      "type": "string",
      "description": "Reference to Volunteer who completed job"
    },
    "volunteer_name": {
      "type": "string",
      "description": "Volunteer name for reference"
    },
    "satisfaction_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Client satisfaction rating 1-5"
    },
    "would_recommend": {
      "type": "boolean",
      "description": "Whether client would recommend service"
    },
    "service_quality": {
      "type": "string",
      "enum": [
        "poor",
        "fair",
        "good",
        "very_good",
        "excellent"
      ],
      "description": "Overall service quality rating"
    },
    "key_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What went well (e.g., punctuality, helpfulness, professionalism)"
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Areas for improvement"
    },
    "qualitative_notes": {
      "type": "string",
      "description": "Free-text feedback from client"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false,
      "description": "Whether client needs follow-up"
    },
    "follow_up_notes": {
      "type": "string",
      "description": "Notes about required follow-up"
    },
    "feedback_date": {
      "type": "string",
      "format": "date-time",
      "description": "When feedback was collected"
    },
    "job_type": {
      "type": "string",
      "description": "Type of job completed"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch where job was completed"
    }
  },
  "required": [
    "job_id",
    "client_id",
    "client_name",
    "volunteer_id",
    "volunteer_name",
    "satisfaction_score",
    "service_quality",
    "feedback_date"
  ]
}