{
  "name": "APIKey",
  "type": "object",
  "properties": {
    "charity_id": {
      "type": "string",
      "description": "Reference to Charity"
    },
    "name": {
      "type": "string",
      "description": "Display name for the API key"
    },
    "key_hash": {
      "type": "string",
      "description": "Hashed API key (never store plain text)"
    },
    "key_preview": {
      "type": "string",
      "description": "Last 4 chars of key for display (e.g., ...abc123)"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Granted API scopes (e.g., read:donors, write:campaigns)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "description": "Last API call timestamp"
    },
    "created_by": {
      "type": "string",
      "description": "User who created the key"
    }
  },
  "required": [
    "charity_id",
    "name",
    "key_hash",
    "key_preview",
    "permissions"
  ]
}