{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referral_number": {
      "type": "string",
      "description": "Auto-generated referral reference (e.g., REF-2026-001)"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "local_authority",
        "gp",
        "self_referral",
        "community_partner"
      ],
      "description": "Source of the referral"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of referring person/organization"
    },
    "referrer_contact": {
      "type": "string",
      "description": "Contact email or phone"
    },
    "referrer_organization": {
      "type": "string",
      "description": "Name of referring organization"
    },
    "client_full_name": {
      "type": "string",
      "description": "Name of client being referred"
    },
    "client_dob": {
      "type": "string",
      "format": "date",
      "description": "Client date of birth"
    },
    "client_postcode": {
      "type": "string",
      "description": "Client postcode"
    },
    "client_phone": {
      "type": "string",
      "description": "Client contact phone"
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "description": "Client contact email"
    },
    "referral_reason": {
      "type": "string",
      "description": "Reason for referral"
    },
    "required_services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "befriending",
          "transport",
          "digital_help",
          "shopping",
          "benefits_advice",
          "home_visit",
          "telephone_check",
          "other"
        ]
      },
      "description": "Services required"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "routine",
        "priority",
        "urgent"
      ],
      "default": "routine",
      "description": "Urgency level"
    },
    "referral_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date referral received"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "qualified",
        "assigned",
        "active",
        "completed",
        "declined",
        "on_hold"
      ],
      "default": "received",
      "description": "Current referral status"
    },
    "qualified_by": {
      "type": "string",
      "description": "Email of person who qualified"
    },
    "qualified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date qualified"
    },
    "qualification_notes": {
      "type": "string",
      "description": "Notes from qualification assessment"
    },
    "decline_reason": {
      "type": "string",
      "description": "Reason for declining referral"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assigned coordinator/volunteer"
    },
    "assigned_name": {
      "type": "string",
      "description": "Name of assigned person"
    },
    "assigned_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date assigned"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client record when created"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch handling this referral"
    },
    "first_contact_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of first contact with client"
    },
    "service_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date service began"
    },
    "progress_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "added_by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Timeline of progress updates"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Attached referral documents"
    }
  },
  "required": [
    "referral_number",
    "referral_source",
    "referrer_name",
    "client_full_name",
    "referral_reason"
  ]
}