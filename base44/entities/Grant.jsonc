{
  "name": "Grant",
  "type": "object",
  "properties": {
    "charity_id": {
      "type": "string",
      "description": "Reference to Charity"
    },
    "grant_name": {
      "type": "string",
      "description": "Grant name"
    },
    "funder_name": {
      "type": "string",
      "description": "Funder name"
    },
    "amount": {
      "type": "number",
      "description": "Grant amount in GBP"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Application deadline"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "awarded",
        "rejected",
        "closed"
      ],
      "default": "draft",
      "description": "Application status"
    },
    "project_title": {
      "type": "string",
      "description": "Project name for this grant"
    },
    "project_description": {
      "type": "string",
      "description": "Project description"
    },
    "beneficiaries": {
      "type": "string",
      "description": "Who benefits"
    },
    "outcomes": {
      "type": "string",
      "description": "Expected outcomes"
    },
    "ai_draft_application": {
      "type": "object",
      "description": "AI-generated application draft",
      "properties": {
        "executive_summary": {
          "type": "string"
        },
        "need_statement": {
          "type": "string"
        },
        "project_description": {
          "type": "string"
        },
        "outcomes_impact": {
          "type": "string"
        },
        "organisation_background": {
          "type": "string"
        },
        "budget_justification": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "charity_id",
    "grant_name",
    "funder_name",
    "amount",
    "deadline"
  ]
}