{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "charity_id": {
      "type": "string",
      "description": "Reference to Charity"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who performed action"
    },
    "action": {
      "type": "string",
      "description": "Action performed (create, update, delete, login, export, etc)"
    },
    "entity_type": {
      "type": "string",
      "description": "Type of entity affected"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of entity affected"
    },
    "changes": {
      "type": "object",
      "description": "What changed (before/after)"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of request"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When action occurred"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ],
      "default": "success"
    }
  },
  "required": [
    "charity_id",
    "user_email",
    "action",
    "timestamp"
  ]
}